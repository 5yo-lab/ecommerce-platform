APP_NAME="Ecommerce Admin"
APP_ENV=local
# Generated on first `docker compose up` (admin-migrate runs `php artisan key:generate`).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Values below are overridden by docker-compose.yml; they are listed for running outside Docker.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="admin@ecommerce.local"
MAIL_FROM_NAME="${APP_NAME}"

# Must match the NestJS gateway.
JWT_SECRET=change-me-to-a-random-32-plus-char-jwt-secret
JWT_ISSUER=ecommerce-platform
INTERNAL_API_KEY=change-me-api-key
API_GATEWAY_URL=http://api-gateway:3000

VITE_APP_NAME="${APP_NAME}"
