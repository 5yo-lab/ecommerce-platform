NODE_ENV=development
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
PRODUCT_CACHE_TTL=300

# Must match the Laravel admin service.
JWT_SECRET=change-me-to-a-random-32-plus-char-jwt-secret
JWT_ISSUER=ecommerce-platform
JWT_TTL=3600
INTERNAL_API_KEY=change-me-api-key

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="Shop <no-reply@ecommerce.local>"
