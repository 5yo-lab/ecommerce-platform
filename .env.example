# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
NODE_ENV=development

# ─── Ports ───────────────────────────────────────────────────────────────────
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ─── Database (shared) ───────────────────────────────────────────────────────
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret

# ─── Shared secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-plus-char-jwt-secret
INTERNAL_API_KEY=change-me-api-key
