APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
NODE_ENV=development
#Set to 1 while editing Laravel code so changes apply without a restart.
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret

JWT_SECRET=change-me-to-a-random-32-plus-char-jwt-secret
INTERNAL_API_KEY=change-me-api-key
